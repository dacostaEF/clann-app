{
  "expo": {
    "name": "CLANN",
    "entryPoint": "./index.js",
    "slug": "cla-app",
    "version": "1.0.0",
    "orientation": "portrait",

    "icon": "./assets/LogoClann_App.png",

    "userInterfaceStyle": "dark",
    "newArchEnabled": true,

    "splash": {
      "backgroundColor": "#000000",
      "image": "./assets/LogoClann_App.png"
    },

    "assetBundlePatterns": ["**/*"],

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cla.app"
    },

    "android": {
      "package": "com.cla.app"
    },

    "web": {
      "favicon": "./LogoClann_favicon.png",
      "themeColor": "#000000"
    },

    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir $(PRODUCT_NAME) acessar sua câmera para escanear QR Codes"
        }
      ],
      "expo-font",
      "expo-secure-store"
    ]
  }
}
