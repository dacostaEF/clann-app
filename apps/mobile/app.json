{
  "expo": {
    "name": "CLANN",
    "slug": "cla-app",
    "version": "1.0.0",
    
    "entryPoint": "./index.js",
    

    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,

    "icon": "./assets/LogoClann_App.png",

    "splash": {
      "image": "./assets/LogoClann_App.png",
      "backgroundColor": "#000000"
    },

    "assetBundlePatterns": ["**/*"],

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cla.app"
    },

    "android": {
      "package": "com.cla.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },

    "plugins": [
      ["expo-camera"],
      "expo-font",
      "expo-secure-store"
    ],

    "extra": {
      "eas": {
        "projectId": "40c892c0-20f6-4c56-b017-67658431d14c"
      }
    },

    "owner": "dacosta.ef"
  }
}
